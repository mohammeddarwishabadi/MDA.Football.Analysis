generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model Team {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  players     Player[]
  matchesHome Match[]  @relation("HomeTeamMatches")
  matchesAway Match[]  @relation("AwayTeamMatches")
}

model Player {
  id         String @id @default(cuid())
  name       String
  team       Team?  @relation(fields: [teamId], references: [id])
  teamId     String?
  position   String?
  goals      Int    @default(0)
  assists    Int    @default(0)
  xG         Float  @default(0)
  keyPasses  Int    @default(0)
  bestIn     Match[]
}

model Match {
  id           String   @id @default(cuid())
  homeTeam     Team     @relation("HomeTeamMatches", fields: [homeTeamId], references: [id])
  homeTeamId   String
  awayTeam     Team     @relation("AwayTeamMatches", fields: [awayTeamId], references: [id])
  awayTeamId   String
  homeGoals    Int
  awayGoals    Int
  xGHome       Float    @default(0)
  xGAway       Float    @default(0)
  bestPlayer   Player?  @relation(fields: [bestPlayerId], references: [id])
  bestPlayerId String?
  playedAt     DateTime
}

model Analysis {
  id        String   @id @default(cuid())
  title     String
  type      String
  content   String
  createdAt DateTime @default(now())
}

model SocialStat {
  id         String   @id @default(cuid())
  platform   String
  views      Int      @default(0)
  engagement Float    @default(0)
  topContent String?
  weekStart  DateTime
}

model HighlightNumber {
  id        String   @id @default(cuid())
  label     String
  value     String
  createdAt DateTime @default(now())
}
